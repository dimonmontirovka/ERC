# ===== Telegram =====
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Куда публиковать. Можно @username канала или числовой id вида -1001234567890.
# Бот должен быть добавлен в канал как администратор с правом публикации.
TELEGRAM_CHANNEL_ID=

# Кому разрешено пользоваться ботом. Числовые Telegram user id через запятую.
# Узнать свой id: напиши боту /start — он подскажет твой id.
ALLOWED_USER_IDS=

# ===== Подпись (последняя строка поста) =====
# Текст перед ссылками. По умолчанию "Прикамские Витязи".
SIGNATURE_PREFIX=Прикамские Витязи

# Слова-гиперссылки и их адреса.
SIGNATURE_TG_WORD=тг
SIGNATURE_TG_URL=https://t.me/your_channel

SIGNATURE_MAX_WORD=макс
SIGNATURE_MAX_URL=https://max.ru/your_channel

# Разделитель между словами-ссылками (между "тг" и "макс").
SIGNATURE_SEPARATOR=/

# ===== МАКС (пока необязательно) =====
# Заполни, когда появится токен бота МАКС. Пока пусто — кнопка МАКС будет
# отвечать, что площадка ещё не подключена.
MAX_BOT_TOKEN=
# chat_id канала/группы в МАКСе, куда публиковать.
MAX_CHAT_ID=
# Базовый адрес Bot API МАКС (на случай смены хоста).
MAX_API_BASE=https://botapi.max.ru
